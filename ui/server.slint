import { Button } from "std-widgets.slint";
import  {
    OuterBorder,
    ImageButton,
    LineInput,
    Container,
    AppWindow,
    Titlebar,
    ColoredButton,
    PopupDialog,
} from "components.slint";

export enum UserState {
    TakingExam,
    FinishedExam,
}
export struct RegisteredUser {
    name: string,
    state: UserState,
    id: int,
}
export struct Exam {
    name: string,
    date: string,
    submissions: int,
    id: int,
    ended: bool,
}

export component ServerApp inherits AppWindow {
    title: "Hyph Server";

    preferred-width: 1300px;
    preferred-height: 650px;
    min-height: 275px;
    min-width: 275px;

    resize-border-width: 10px;

    callback close_program();
    callback mouse_move(length, length);
    callback show_previous_exam(int);
    callback back_exam();
    callback new_exam();

    in property <[Exam]> previous_exams: [
        {
            name: "Programming test",
            date: "13/10 2026",
            submissions: 16,
        },
        {
            name: "Programming test2",
            date: "26/09 2026",
            submissions: 16,
        }
    ];
    in property <[RegisteredUser]> registered_users: [{
        name:"Person Personson",
        state: UserState.TakingExam,
        id:45,
    }];

    in property <Exam> active-exam: { id:0 };

    Titlebar {
        width: parent.width;
        height: parent.height;
        titlebar-text: "Hyph Server";
        mouse_move(a, b) => mouse_move(a,b);
        close_program => close_program();
    }

    // page before exam started
    Container {
        visible: active-exam.id == 0;
        width: parent.width;
        height: parent.height;
        Text {
            text: "Previous exams:";
            font-size: 20px;
            y: 50px;
            x: 20px;
        }

        Text {
            visible: root.previous_exams.length == 0;
            text: "No prior exams found. Click the button below to create one!";
            y: 80px;
            x: 20px;
        }

        ColoredButton {
            text: "New Exam";
            height: 40px;
            color: #45e082;
            width: 150px;
            y: previous_exams.length > 0 ? (parent.height - self.height - 20px) : 120px;
            x: 20px;
            clicked => {
                name-input.show(root.width,root.height);
            };
        }

        FlexboxLayout {
            width: parent.width - 40px;
            max-width: parent.width;
            spacing: 20px;
            spacing-vertical: 20px;
            y: 90px;
            for exam in root.previous_exams: Rectangle {
                width: date.width + submissions.width + 20px;
                height: 90px;

                title := Text {
                    font-size: 14px;
                    text: exam.name;
                    x: 5px;
                    y: 2px;
                    font-italic: true;
                    font-weight: 800;
                }

                date := Text {
                    font-size: 14px;
                    y: 20px;
                    x: parent.width - self.width - 5px;
                    text: exam.date;
                }

                submissions := Text {
                    font-size: 14px;
                    y: 20px;
                    x: 5px;
                    text: exam.submissions + " submissions";
                }

                Button {
                    text: "View Submissions";
                    x: 5px;
                    width: parent.width - 10px;
                    y: parent.height - self.height - 5px;
                    clicked => root.show_previous_exam(exam.id);
                }

                OuterBorder {
                    padding-width: 2px;
                    width: parent.width;
                    height: parent.height;
                    border-color: rgb(61, 68, 77);
                }
            }
        }

        dark-overlay := Rectangle {
            visible: name-input.visible;
            width: root.width;
            height: root.height - 40px;
            y: 40px;
            background: rgba(10,10,10,0.3);
            TouchArea {
                width: parent.width;
                height: parent.height;
            }
        }

        name-input := PopupDialog {
            title: "Enter exam name";
            height: 155px;

            on_show => {
                name-input-input.reset();
            }

            Text {
                text: "Enter a name for the exam";
                x: 15px;
                y: 40px;
            }

            name-input-input := LineInput {
                x: 18px;
                y: 70px;
                width: parent.width - 36px;
            }

            HorizontalLayout {
                alignment: start;
                y: parent.height - self.height - 10px;
                x: 15px;
                height: 30px;
                spacing: 5px;
                ColoredButton {
                    text: "Create";
                    color: #45e082;
                }

                Button {
                    text: "Cancel";
                    clicked => name-input.hide();
                }
            }
        }
    }

    // page when exam started
    Container {
        visible: active-exam.id != 0;
        width: parent.width;
        height: parent.height;
        Button {
            x: 17px;
            y: 49px;
            text: "Back";
            clicked => root.back_exam();
        }

        FlexboxLayout {
            width: parent.width - 40px;
            max-width: parent.width;
            spacing: 20px;
            spacing-vertical: 20px;
            y: 90px;

            for user in root.registered_users: Rectangle {
                width: max(user-name.width,user-state.width,cheating-indicator.width) + 10px;
                height: 90px;

                user-name := Text {
                    font-size: 14px;
                    text: user.name;
                    font-weight: 800;
                    x: 5px;
                    y: 2px;
                }

                user-state := Text {
                    states [
                        active when user.state == UserState.TakingExam: {
                            text: "Currently Taking Exam";
                            color: #2c9bf7;
                        }
                        active when user.state == UserState.FinishedExam: {
                            text: "Finished Exam";
                            color: #45e082;
                        }
                    ]
                    y: 22px;
                    x: 5px;
                }

                cheating-indicator := Text {
                    text: "No cheating detected.";
                    color: grey;
                    y: 36px;
                    x: 5px;
                }

                Button {
                    text: "View Exam";
                    x: 5px;
                    width: parent.width - 10px;
                    height: 25px;
                    y: parent.height - self.height - 5px;
                    // clicked => root.show_previous_exam(exam.id);
                }

                OuterBorder {
                    padding-width: 2px;
                    width: parent.width;
                    height: parent.height;
                    border-color: rgb(61, 68, 77);
                }
            }
        }
    }
}
