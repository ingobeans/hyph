import { Button } from "std-widgets.slint";
import  {
    OuterBorder,
    ImageButton,
    LineInput,
    Container,
    AppWindow,
    Titlebar,
} from "components.slint";

export struct RegisteredUser {
    name: string,
    state: int,
}

export component ServerApp inherits AppWindow {
    title: "Hyph Server";
    width: 1300px;
    height: 650px;

    callback mouse_move(length, length);
    in property <[RegisteredUser]> registered_users: [{ name:"person", state: 0 }];

    Titlebar {
        width: parent.width;
        height: parent.height;
        titlebar-text: "Hyph Server";
        mouse_move(a, b) => mouse_move(a,b);
    }

    HorizontalLayout {
        alignment: start;
        width: 200px;
        spacing: 20px;
        y: 300px;
        for user in root.registered_users: Rectangle {
            background: grey;
            height: 20px;
            Text {
                text: user.name;
            }
        }
    }
}
