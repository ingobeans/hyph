import  {
    OuterBorder,
    ImageButton,
    LineInput,
    Container,
    AppWindow,
    Titlebar,
    Button,
    PopupDialog,
} from "components.slint";
import { ScrollView } from "std-widgets.slint";

export enum UserState {
    TakingExam,
    FinishedExam,
}
export struct RegisteredUser {
    name: string,
    state: UserState,
    cheating-detected: bool,
    id: duration, // use durations for ID since its represented by a 64 bit integer rather than 32 bit
}
export struct Exam {
    name: string,
    date: string,
    submissions: int,
    id: duration, // use durations for ID since its represented by a 64 bit integer rather than 32 bit
    ended: bool,
}
export struct TimelineBar {
    start: float,
    end: float,
}
export struct TimelineEntry {
    name: string,
    bars: [TimelineBar],
}
export struct InspectedSubmission {
    user: RegisteredUser,
    exam_length: float,
    timeline_entries: [TimelineEntry],
}

component CheatingIndicator inherits Text {
    in property <bool> cheating;
    text: cheating ? "Cheating was detected" : "No cheating detected.";
    color: cheating ? #ec3e5b : grey;
    y: 36px;
    x: 5px;
}

export component ServerApp inherits AppWindow {
    title: "Hyph Server";

    preferred-width: 1030px;
    preferred-height: 520px;
    min-height: 275px;
    min-width: 275px;

    resize-border-width: 10px;

    callback close_program();
    callback maximize_program();
    callback minimize_program();
    callback mouse_move(length, length);
    callback show_previous_exam(duration);
    callback back_exam();
    callback new_exam(string);
    callback start_exam(Exam);
    callback inspect_submission(RegisteredUser, Exam);
    callback stop_exam();

    in property <[Exam]> previous_exams: [
        {
            name: "Programming test",
            date: "13/10 2026",
            submissions: 16,
        },
        {
            name: "Programming test2",
            date: "26/09 2026",
            submissions: 16,
        }
    ];

    // testing placeholders:
    in property <[RegisteredUser]> registered_users: [
        {
            name:"Person Personson",
            state: UserState.TakingExam,
            id:45ms,
        },
        {
            name:"Person Personson",
            state: UserState.FinishedExam,
            id:45ms,
        },
        {
            name:"Person Personson",
            state: UserState.TakingExam,
            id:45ms,
        },
        {
            name:"Person Personson",
            state: UserState.FinishedExam,
            id:45ms,
        },
        {
            name:"Person Personson",
            state: UserState.FinishedExam,
            id:45ms,
            cheating-detected: true,
        }
    ];

    in property <Exam> active-exam: {
        // id:1ms,
        name:"Placeholder Exam Name",
        ended: true,
        date: "14/10 2026",
    };

    in-out property <InspectedSubmission> inspected-submission: {
        user: {
            name: "Person McPerson",
            // id: 1ms,
        },
        exam-length:60.0 * 70.0,
        timeline_entries: [
            {
                name:"Windows Explorer",
                bars: [
                    {
                        start: 0.0,
                        end: 0.15,
                    },
                    {
                        start: 0.25,
                        end: 0.35,
                    },
                ],
            },
            {
                name:"Window with Things",
                bars: [
                    {
                        start: 0.0,
                        end: 0.26,
                    },
                    {
                        start: 0.28,
                        end: 1.0,
                    },
                ],
            }
        ],
    };

    Titlebar {
        width: parent.width;
        height: parent.height;
        titlebar-text: "Hyph Server";
        extra-controls: true;
        mouse_move(a, b) => mouse_move(a,b);
        close_program => close_program();
        minimize_program => minimize_program();
        maximize_program => maximize_program();
    }

    // page before exam started
    Container {
        visible: active-exam.id == 0 && inspected-submission.user.id == 0ms;
        width: parent.width;
        height: parent.height;
        Text {
            text: "Previous exams:";
            font-size: 20px;
            y: 50px;
            x: 20px;
        }

        Text {
            visible: root.previous_exams.length == 0;
            text: "No prior exams found. Click the button below to create one!";
            y: 80px;
            x: 20px;
        }

        Button {
            text: "New Exam";
            height: 40px;
            color: #45e082;
            width: 150px;
            y: previous_exams.length > 0 ? (parent.height - self.height - 20px) : 120px;
            x: 20px;
            clicked => {
                exam-name-popup.show(root.width,root.height);
            };
        }

        FlexboxLayout {
            width: parent.width - 40px;
            max-width: parent.width;
            spacing: 20px;
            spacing-vertical: 20px;
            y: 90px;
            for exam in root.previous_exams: Rectangle {
                width: date.width + submissions.width + 20px;
                height: 90px;

                title := Text {
                    font-size: 14px;
                    text: exam.name;
                    x: 5px;
                    y: 2px;
                    font-italic: true;
                    font-weight: 800;
                }

                date := Text {
                    font-size: 14px;
                    y: 20px;
                    x: parent.width - self.width - 5px;
                    text: exam.date;
                }

                submissions := Text {
                    font-size: 14px;
                    y: 20px;
                    x: 5px;
                    text: exam.submissions + " submissions";
                }

                Button {
                    text: "View Submissions";
                    x: 5px;
                    width: parent.width - 10px;
                    y: parent.height - self.height - 5px;
                    height: 30px;
                    clicked => root.show_previous_exam(exam.id);
                }

                OuterBorder {
                    padding-width: 2px;
                    width: parent.width;
                    height: parent.height;
                    border-color: rgb(61, 68, 77);
                }
            }
        }

        dark-overlay := Rectangle {
            visible: exam-name-popup.visible;
            width: root.width;
            height: root.height - 40px;
            y: 40px;
            background: rgba(10,10,10,0.3);

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    exam-name-popup.hide();
                }
            }
        }

        exam-name-popup := PopupDialog {
            title: "Enter exam name";
            height: 155px;

            on_show => {
                exam-name-input.reset();
                exam-name-input.set_focus();
            }

            Text {
                text: "Enter a name for the exam";
                x: 15px;
                y: 40px;
            }

            exam-name-input := LineInput {
                x: 18px;
                y: 70px;
                width: parent.width - 36px;
            }

            HorizontalLayout {
                alignment: start;
                y: parent.height - self.height - 10px;
                x: 15px;
                height: 30px;
                spacing: 5px;
                Button {
                    text: "Create";
                    color: #45e082;
                    clicked => { exam-name-popup.hide(); root.new_exam(exam-name-input.out-text); }
                }

                Button {
                    text: "Cancel";
                    clicked => exam-name-popup.hide();
                }
            }
        }
    }

    // page when exam started
    Container {
        visible: active-exam.id != 0;
        width: parent.width;
        height: parent.height;
        Button {
            y: 49px;
            x: 17px;
            text: "Back";
            height: 30px;
            clicked => root.back_exam();
        }

        Text {
            text: active-exam.name;
            font-size: 20px;
            y: 49px;
        }

        Text {
            x: root.width - self.width - 10px;
            text: active-exam.date;
            font-size: 13px;
            y: 49px;
        }

        active-exam-status := Text {
            x: (root.width - (toggle-exam-open.width + active-exam-status.width + 3px)) / 2 + toggle-exam-open.width + 3px;
            font-size: 14px;
            y: 75.5px;
            states [
                active when !active-exam.ended: {
                    text: "Exam Currently Open";
                    color: #45e082;
                }
                active when active-exam.ended: {
                    text: "Exam Closed";
                    color: grey;
                }
            ]
        }

        toggle-exam-open := Container {
            x: (root.width - (toggle-exam-open.width + active-exam-status.width + 3px)) / 2;
            y: 74px;
            width: 20px;
            ImageButton {
                image: @image-url("assets/pause.png");
                visible: !active-exam.ended;
                height: parent.width;
                width: parent.width;
                x: 0;
                y: 0;
                clicked => root.stop_exam();
            }

            ImageButton {
                image: @image-url("assets/play.png");
                visible: active-exam.ended;
                height: parent.width;
                width: parent.width;
                x: 0;
                y: 0;
                clicked => root.start_exam(active-exam);
            }
        }

        FlexboxLayout {
            width: parent.width - 40px;
            max-width: parent.width;
            spacing: 20px;
            spacing-vertical: 20px;
            y: 110px;

            for user in root.registered_users: Rectangle {
                width: max(user-name.width,user-state.width,cheating-indicator.width) + 10px;
                height: 90px;

                user-name := Text {
                    font-size: 14px;
                    text: user.name;
                    font-weight: 800;
                    x: 5px;
                    y: 2px;
                }

                user-state := Text {
                    states [
                        active when user.state == UserState.TakingExam: {
                            text: "Currently Taking Exam";
                            color: #2c9bf7;
                        }
                        active when user.state == UserState.FinishedExam: {
                            text: "Finished Exam";
                            color: #45e082;
                        }
                    ]
                    y: 22px;
                    x: 5px;
                }

                cheating-indicator := CheatingIndicator {
                    cheating: user.cheating-detected;
                }

                Button {
                    text: "View Exam";
                    enabled: user.state == UserState.FinishedExam;
                    x: 5px;
                    width: parent.width - 10px;
                    height: 25px;
                    y: parent.height - self.height - 5px;
                    clicked => root.inspect_submission(user, active-exam);
                }

                OuterBorder {
                    padding-width: 2px;
                    width: parent.width;
                    height: parent.height;
                    border-color: rgb(61, 68, 77);
                }
            }
        }
    }

    // page when inspecting specific submission
    Container {
        visible: inspected-submission.user.id != 0ms;
        width: parent.width;
        height: parent.height;

        Rectangle {
            height: parent.height - 40px - 1px;
            width: parent.width - 2px;
            y: 40px;
            background: #00000099;
            x: 1px;

            active-window := Rectangle {
                background: rgb(13, 17, 23);
                width: 90%;
                x: 0;
            }
        }

        ImageButton {
            y: 45px;
            x: active-window.width - 35px;
            width: 30px;
            height: 20px;
            image: @image-url("assets/minus.png");
            clicked => { inspected-submission.user.id = 0ms };
        }

        Text {
            text: inspected-submission.user.name;
            font-size: 20px;
            y: 50px;
            x: 20px;
        }

        CheatingIndicator {
            cheating: inspected-submission.user.cheating-detected;
            y: 80px;
            x: 20px;
        }

        Button {
            y: 100px;
            x: 20px;
            text: "Show Submitted Folder";
            height: 30px;
        }

        Rectangle {
            width: active-window.width;
            height: 30%;
            x: 0;
            y: parent.height - self.height;
            background: black;

            ScrollView {
                y: 0;
                height: parent.height;
                width: parent.width;
                content-height: 300px;
                for entry[index] in inspected-submission.timeline-entries: Container {
                    y: index * self.height;
                    width: parent.width;
                    height: 20px;

                    entry-label := Text {
                        x: 10px;
                        height: 20px;
                        text: entry.name;
                        y: 4px;
                    }

                    for bar[j] in entry.bars: Rectangle {
                        y: 8px;
                        background: #63b9ff;
                        height: 5px;
                        x: entry-label.width + 20px + bar.start * (parent.width - entry-label.width - 30px);
                        width: (bar.end - bar.start) * (parent.width - entry-label.width - 30px);
                        border-radius: 5px;
                    }
                    Rectangle {
                        background: rgb(61, 68, 77);
                        height: 2px;
                        y: parent.height;
                    }
                }
            }

            Rectangle {
                background: rgb(61, 68, 77);
                height: 2px;
                y: 0;
            }
        }
    }
}
