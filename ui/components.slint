export component OuterBorder {
    in property <brush> border-color;
    in property <length> padding-width;
    Rectangle {
        x: -parent.padding-width;
        y: -parent.padding-width - 1px;
        width: (parent.width) + 1px + parent.padding-width * 2;
        height: 1px;
        background: parent.border-color;
    }

    Rectangle {
        x: -parent.padding-width - 1px;
        y: -parent.padding-width - 1px;
        width: 1px;
        height: (parent.height) + 1px * 2 + parent.padding-width * 2;
        background: parent.border-color;
    }

    Rectangle {
        x: -parent.padding-width;
        y: (parent.height) + parent.padding-width;
        width: (parent.width) + 1px + parent.padding-width * 2;
        height: 1px;
        background: parent.border-color;
    }

    Rectangle {
        x: parent.width + parent.padding-width;
        y: -parent.padding-width;
        width: 1px;
        height: (parent.height) + 1px + parent.padding-width * 2;
        background: parent.border-color;
    }
}

export component Button {
    in property <bool> enabled: true;
    in property <string> text: "Button";
    in property <brush> color: #1B1F25;
    in property <length> padding-width: 30px;
    callback clicked();

    width: text-element.width + padding-width;

    area := TouchArea {
        clicked => {
            if root.enabled {
                root.clicked();
            }
        };
    }

    Rectangle {
        border-radius: 5px;
        border-width: 0.5px;
        border-color: grey;
        states [
            disabled when !root.enabled: {
                background: #34373c;
                out {
                    animate background { duration: 150ms; }
                }
            }
            enabled-hovered when area.has-hover: {
                background: root.color.brighter(root.color.to-hsv().value > 0.5 ? -0.2 : 0.2);
                out {
                    animate background { duration: 150ms; }
                }
            }
            enabled when !area.has-hover: {
                background: root.color;
                out {
                    animate background { duration: 150ms; }
                }
            }
        ]
    }

    text-element := Text {
        text: root.text;
        color: root.enabled ? (root.color.to-hsv().value > 0.5 ? black : white) : grey;
    }
}

export component Container {
    @children
}

export component LineInput {
    width: 260px;
    height: 30px;
    in property <length> padding-width: 8px;
    out property <string> out-text;
    in property <bool> enabled: true;

    public function reset() {
        input.text = "";
    }
    public function set_focus() {
        input.focus();
    }

    input := TextInput {
        width: (parent.width) - root.padding-width;
        height: (parent.height) - root.padding-width;
        single-line: true;
        font-size: 20px;
        enabled: root.enabled;
        changed text => {
            parent.out-text = self.text;
        };
        OuterBorder {
            padding-width: root.padding-width;
            width: parent.width;
            height: parent.height;
            border-color: rgb(61, 68, 77);
        }
    }
}

export component ImageButton inherits TouchArea {
    in property <image> image: @image-url("assets/cross.png");
    in property <brush> normal-color: white;
    in property <brush> hover-color: #b4b4b4;
    in property <brush> clicked-color: #a0a0a0;
    in property <length> border-width: 0.5px;

    img := Image {
        source: root.image;
        colorize: white;
        width: parent.width - 5px;
        height: parent.height - 5px;
    }

    Rectangle {
        border-color: img.colorize;
        border-width: root.border-width;
        width: parent.width;
        height: parent.height;
        border-radius: 2px;
    }

    changed enabled => {
        if (self.enabled) {
            if (self.pressed) {
                img.colorize = root.clicked-color;
            } else if (self.has-hover) {
                img.colorize = root.hover-color;
            } else {
                img.colorize = root.normal-color;
            }
        } else {
            img.colorize = root.clicked-color;
        }
    }

    changed has-hover => {
        if (self.enabled) {
            if (self.pressed) {
                img.colorize = root.clicked-color;
            } else if (self.has-hover) {
                img.colorize = root.hover-color;
            } else {
                img.colorize = root.normal-color;
            }
        } else {
            img.colorize = root.clicked-color;
        }
    }

    pointer-event() => {
        if (self.enabled) {
            if (self.pressed) {
                img.colorize = root.clicked-color;
            } else if (self.has-hover) {
                img.colorize = root.hover-color;
            } else {
                img.colorize = root.normal-color;
            }
        } else {
            img.colorize = root.clicked-color;
        }
    }
}

export component Titlebar {
    callback mouse_move(length, length);
    callback close_program();
    callback maximize_program();
    callback minimize_program();
    in property <string> titlebar-text;
    in property <bool> close-enabled: true;
    in property <bool> small: false;
    in property <bool> extra-controls;

    TouchArea {
        y: 0;
        height: !small ? 40px : 30px;
        Rectangle {
            background: #010409;
            OuterBorder {
                padding-width: -1px;
                width: parent.width;
                height: parent.height;
                border-color: rgb(61, 68, 77);
            }
        }

        moved => {
            if (self.pressed) {
                root.mouse_move((self.mouse_x) - self.pressed_x, (self.mouse_y) - self.pressed_y);
            }
        }
    }

    OuterBorder {
        padding-width: -1px;
        width: parent.width;
        height: parent.height;
        border-color: rgb(61, 68, 77);
    }

    Text {
        text: root.titlebar-text;
        font-size: !small ? 28px : 15px;
        y: 5px;
        x: !small ? ((parent.width - self.width) / 2) : 7px;
    }

    close-btn := ImageButton {
        enabled: root.close-enabled;
        width: !small ? 30px : 20px;
        height: !small ? 30px : 20px;
        x: (parent.width) - (self.width) - 5px;
        y: 5px;

        clicked => close_program();
    }

    maximize-btn := ImageButton {
        visible: root.extra-controls;
        enabled: root.close-enabled;
        image: @image-url("assets/square.png");
        width: !small ? 30px : 20px;
        height: !small ? 30px : 20px;
        border-width: self.has-hover ? 0.5px : 0;
        x: (parent.width) - (self.width) - 5px - (self.width + 5px);
        y: 5px;

        clicked => maximize_program();
    }

    minimize-btn := ImageButton {
        visible: root.extra-controls;
        image: @image-url("assets/minus.png");
        enabled: root.close-enabled;
        width: !small ? 30px : 20px;
        height: !small ? 30px : 20px;
        border-width: self.has-hover ? 0.5px : 0;
        x: (parent.width) - (self.width) - 5px - (self.width + 5px) * 2;
        y: 5px;

        clicked => minimize_program();
    }
}

export component PopupDialog {
    visible: false;
    width: 400px;
    height: 150px;
    callback on_show();
    in property <string> title;

    public function show(parent_width: length, parent_height: length) {
        self.x = (parent_width - self.width) / 2;
        self.y = (parent_height - self.height) / 2;
        self.visible = true;
        on_show();
    }
    public function hide() {
        self.visible = false;
    }

    Rectangle {
        background: rgb(13, 17, 23);
        drop-shadow-color: black;
        drop-shadow-offset-x: 10px;
        drop-shadow-offset-y: 10px;
        drop-shadow-blur: 20px;
    }

    // just to stop clicks going through
    TouchArea {
        width: parent.width;
        height: parent.height;
    }

    Titlebar {
        width: parent.width;
        height: parent.height;
        titlebar-text: root.title;
        small: true;
        mouse_move(x, y) => {
            parent.x += x;
            parent.y += y;
        }
        close_program => {
            root.hide();
        }
    }

    @children
}

export component AppWindow inherits Window {
    background: rgb(13, 17, 23);
    no-frame: true;
    preferred-width: 990px;
    preferred-height: 450px;
}
